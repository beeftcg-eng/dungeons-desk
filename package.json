{
  "name": "dungeons-desk",
  "version": "1.5.2",
  "description": "Dungeons Desk: a desktop toolkit for Dungeon Masters",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js --serve",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "release": "node scripts/release.js",
    "test": "node scripts/test-charsheet.js && node scripts/test-pdfchar.js && node scripts/test-bookimport.js && node scripts/test-homebrew.js && node scripts/test-library.js && node scripts/test-tablenotes.js && node scripts/test-server.js && node scripts/test-mapsight.js"
  },
  "author": {
    "name": "beeftcg-eng",
    "email": "beeftcg@gmail.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^3.11.174"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "marked": "^12.0.2",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "productName": "Dungeons Desk",
  "homepage": "https://github.com/beeftcg-eng/dungeons-desk",
  "repository": {
    "type": "git",
    "url": "https://github.com/beeftcg-eng/dungeons-desk.git"
  },
  "build": {
    "appId": "com.beeftcg.dungeonsdesk",
    "productName": "Dungeons Desk",
    "copyright": "Copyright © 2026 beeftcg-eng",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "renderer/**",
      "player/**",
      "shared/**",
      "seed/**",
      "build/icon*.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "beeftcg-eng",
        "repo": "dungeons-desk",
        "releaseType": "draft"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon-512.png",
      "artifactName": "Dungeons-Desk-${version}-linux-${arch}.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ],
      "description": "Notes, maps, initiative and more for D&D",
      "desktop": {
        "entry": {
          "Name": "Dungeons Desk"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dungeons Desk",
      "artifactName": "Dungeons-Desk-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
